<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>electrabytes04.dev</title>
  <link rel="stylesheet" href="/main.css" />
</head>
<body>
  <div id="content-wrapper">
    <div id="slim-nav">
      <a href="#closed">Close</a>
      <a href="#right-margin">Page Nav.</a>
    </div>

    <!-- Right Margin Content -->
    <div id="right-margin">
      <h2>Page Nav.</h2>
      <a href="/">Index</a>
      $table-of-contents$
    </div>

    <!-- Main Content -->
    <div id="page">
      <h1>$title$</h1>
      <hr>
      $body$
    </div>
  </div>
</body>
</html>
